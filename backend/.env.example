AE_ENVIRONMENT=development
AE_AUTH_MODE=local
AE_DATABASE_URL=postgresql+asyncpg://autoeval:replace-password@127.0.0.1:5432/autoeval
AE_TEMPORAL_ADDRESS=127.0.0.1:7233
AE_TEMPORAL_NAMESPACE=default
AE_S3_ENDPOINT=http://127.0.0.1:9000
AE_S3_BUCKET=autoeval-evidence
AE_S3_ACCESS_KEY=replace-user
AE_S3_SECRET_KEY=replace-password

# Optional Harbor trace imports (keys stay server-side)
# AE_LANGFUSE_HOST=http://127.0.0.1:18930
# AE_LANGFUSE_BROWSER_URL=http://127.0.0.1:18930
# AE_LANGFUSE_PROJECT_ID=
# AE_LANGFUSE_PUBLIC_KEY=
# AE_LANGFUSE_SECRET_KEY=
# AE_LANGFUSE_CONTENT_MODE=full

# Hide retired manifests from new-task options; keep immutable historical references.
AE_ARCHIVED_MANIFEST_IDS=[]

# OAuth 登录（GitHub / GitCode）：在对应平台注册 OAuth App 后填入凭据并取消注释。
# 开发模式回调直连后端 127.0.0.1:8000（GitCode 的回调地址校验不接受 localhost），
# 前端页面请用 http://127.0.0.1:5173 访问，使会话 Cookie 与页面同属 127.0.0.1 域。
# 平台注册的回调地址填: http://127.0.0.1:8000/api/autoeval/v1/auth/callback/{provider}
# AE_AUTH_MODE=oauth
# AE_OAUTH_ENABLED_PROVIDERS=github,gitcode
# AE_GITHUB_CLIENT_ID=
# AE_GITHUB_CLIENT_SECRET=
# AE_GITCODE_CLIENT_ID=
# AE_GITCODE_CLIENT_SECRET=
# AE_OAUTH_REDIRECT_BASE=http://127.0.0.1:8000
# AE_FRONTEND_ORIGIN=http://127.0.0.1:5173
# AE_SESSION_TTL_HOURS=168
# 首次登录即授予管理员（provider:平台用户名，比对的是 login 而非昵称，逗号分隔）
# AE_ADMIN_ACCOUNTS=github:your-login,gitcode:your-login
