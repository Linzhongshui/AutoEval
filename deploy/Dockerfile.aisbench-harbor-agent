FROM autoeval/aisbench-harbor:d97a8e7-f59cb89-accuracy-platform-linux AS accuracy
FROM autoeval/aisbench-harbor:d97a8e7-f59cb89-agent-platform-linux

# Use the same Git-pinned adaptor package and provenance as the accuracy worker.
COPY --from=accuracy /opt/autoeval-adaptor-955089a /opt/autoeval-adaptor-955089a
ENV PYTHONPATH=/opt/autoeval-adaptor-955089a:/opt/autoeval-platform-runtime/deps:/opt/autoeval-platform-runtime:/opt/autoeval-aisbench-d97a8e7:/opt/autoeval-harbor-f59cb89/src:/opt/autoeval-harbor-f59cb89/adapters/automationbench/src

# The SSH planning transport invokes python3 without the acceptance workspace mounted.
RUN ln -sf /usr/bin/python3 /usr/local/bin/python3

# The pinned runner uses a logger method that AISLogger does not implement.
RUN runner=/opt/autoeval-aisbench-d97a8e7/ais_bench/benchmark/runners/harbor_runner.py \
    && grep -q 'self.logger.exception(' "$runner" \
    && sed -i 's/self\.logger\.exception(/self.logger.error(__import__("traceback").format_exc() + /g' "$runner"

# Verify the entrypoint resolves the bundled implementation and agent.
RUN /opt/venvs/harbor/bin/python -c 'import harbor; from automationbench_adapter.agent import AutomationBenchOfficialAgent; assert harbor.__file__.startswith("/opt/autoeval-harbor-f59cb89/src/")'
